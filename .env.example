# Firebase Web App config (https://console.firebase.google.com -> Project settings -> SDK setup)
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=buy-the-way-2ac6e
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Use Firestore emulator (true/false)
VITE_USE_EMULATOR=false

# Use in-memory fixtures instead of Firestore (1 = on, 0 = off)
VITE_USE_FIXTURES=0
