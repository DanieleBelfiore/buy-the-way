{
  "name": "buy-the-way",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "vue-tsc --noEmit && vite build",
    "build:analyze": "vite build --mode analyze",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "firebase emulators:exec --only auth,firestore --project=buy-the-way 'playwright test'",
    "test:e2e:ui": "firebase emulators:exec --only auth,firestore --project=buy-the-way 'playwright test --ui'",
    "test:rules": "firebase emulators:exec --only firestore --project=demo-buy-the-way 'vitest run --config vitest.rules.config.ts'",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "firebase:emulators": "firebase emulators:start --only auth,firestore",
    "firebase:deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes"
  },
  "dependencies": {
    "@fontsource-variable/hanken-grotesk": "^5.2.8",
    "@lottiefiles/dotlottie-vue": "^0.11.13",
    "@lucide/vue": "^1.16.0",
    "@sentry/vue": "^10.53.1",
    "@unhead/vue": "^3.1.0",
    "@vueuse/motion": "^3.0.3",
    "chart.js": "^4.5.1",
    "firebase": "^12.13.0",
    "pinia": "^3.0.4",
    "ulid": "^3.0.2",
    "vue": "^3.5.34",
    "vue-chartjs": "^5.3.3",
    "vue-i18n": "^11.4.4",
    "vue-router": "^5.0.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "protobufjs",
      "vue-demi"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.6",
    "@vue/test-utils": "^2.4.10",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.4.0",
    "eslint-plugin-vue": "^10.9.1",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.14",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.6",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.3.0",
    "workbox-window": "^7.4.1"
  }
}