{
  "name": "buy-the-way",
  "private": true,
  "version": "1.8.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--disable-warning=DEP0205 vite",
    "preview": "vite preview",
    "build": "vue-tsc --noEmit && NODE_OPTIONS=--disable-warning=DEP0205 vite build",
    "build:analyze": "NODE_OPTIONS=--disable-warning=DEP0205 vite build --mode analyze",
    "typecheck": "vue-tsc --noEmit",
    "test": "NODE_OPTIONS=--disable-warning=DEP0205 vitest",
    "test:run": "NODE_OPTIONS=--disable-warning=DEP0205 vitest run",
    "test:coverage": "NODE_OPTIONS=--disable-warning=DEP0205 vitest run --coverage",
    "test:e2e": "firebase emulators:exec --only auth,firestore --project=buy-the-way 'playwright test'",
    "test:e2e:ui": "firebase emulators:exec --only auth,firestore --project=buy-the-way 'playwright test --ui'",
    "test:rules": "firebase emulators:exec --only firestore,storage --project=demo-buy-the-way 'vitest run --config vitest.rules.config.ts'",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "firebase:emulators": "firebase emulators:start --only auth,firestore",
    "firebase:deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes,storage",
    "storage:cors": "bash scripts/apply-storage-cors.sh",
    "firebase:wipe:prod": "node scripts/wipe-firestore.mjs",
    "report:users": "node scripts/report-users.mjs",
    "csp:hash": "node scripts/check-csp-hash.mjs",
    "release:patch": "pnpm version patch -m \"🦄 RELEASE: v%s\"",
    "release:minor": "pnpm version minor -m \"🦄 RELEASE: v%s\"",
    "release:major": "pnpm version major -m \"🦄 RELEASE: v%s\""
  },
  "dependencies": {
    "@fontsource-variable/hanken-grotesk": "5.2.8",
    "@lottiefiles/dotlottie-vue": "0.11.15",
    "@lucide/vue": "1.21.0",
    "@unhead/vue": "3.1.4",
    "@vueuse/motion": "3.0.3",
    "chart.js": "4.5.1",
    "firebase": "12.15.0",
    "firebase-admin": "14.0.0",
    "pinia": "3.0.4",
    "resend": "6.14.0",
    "ulid": "3.0.2",
    "vue": "3.5.38",
    "vue-chartjs": "5.3.3",
    "vue-draggable-plus": "0.6.1",
    "vue-i18n": "11.4.6",
    "vue-router": "5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.3",
    "@firebase/rules-unit-testing": "5.0.1",
    "@netlify/functions": "5.3.0",
    "@playwright/test": "1.61.0",
    "@tailwindcss/postcss": "4.3.1",
    "@typescript-eslint/eslint-plugin": "8.61.1",
    "@typescript-eslint/parser": "8.61.1",
    "@vitejs/plugin-vue": "6.0.7",
    "@vitest/coverage-v8": "4.1.9",
    "@vue/test-utils": "2.4.11",
    "autoprefixer": "10.5.0",
    "eslint": "10.5.0",
    "eslint-plugin-vue": "10.9.2",
    "jsdom": "29.1.1",
    "postcss": "8.5.15",
    "prettier": "3.8.4",
    "tailwindcss": "4.3.1",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.9",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.5",
    "workbox-window": "7.4.1"
  }
}