rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // User profiles — any authenticated user can read (for email lookup); write only by self
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Lists — collaborators can read/update; owner can create/delete
    match /lists/{listId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.collaboratorUids;

      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.ownerUid
        && request.auth.uid in request.resource.data.collaboratorUids;

      allow update: if request.auth != null
        && request.auth.uid in resource.data.collaboratorUids;

      allow delete: if request.auth != null
        && request.auth.uid == resource.data.ownerUid;

      // Items subcollection — any collaborator on the parent list can read/write
      match /items/{itemId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/lists/$(listId)).data.collaboratorUids;
      }
    }

    // Per-user catalog — owner only
    match /catalog/{userId}/entries/{entryId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
