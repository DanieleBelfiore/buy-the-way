rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isMember(listId) {
      let list = get(/databases/$(database)/documents/lists/$(listId));
      return request.auth.uid == list.data.ownerUid
          || request.auth.uid in list.data.collaboratorUids;
    }

    // ── users/{uid} ───────────────────────────────────────────────────────
    // Any authenticated user may read profiles (required for email→uid lookup).
    // Only the account owner may create or update their own document.
    match /users/{uid} {
      allow read: if isAuth();
      allow create, update: if isAuth() && request.auth.uid == uid;
      allow delete: if false;
    }

    // ── lists/{listId} ────────────────────────────────────────────────────
    // Owner and collaborators may read.
    // Only the owner may create a list (must self-declare as owner).
    // Members (owner or collaborator) may update — covers rename, soft-delete,
    // addCollaborator, leaveList.  Hard deletes are blocked; use soft-delete.
    match /lists/{listId} {
      allow read: if isAuth()
          && (request.auth.uid == resource.data.ownerUid
              || request.auth.uid in resource.data.collaboratorUids);

      allow create: if isAuth()
          && request.resource.data.ownerUid == request.auth.uid;

      allow update: if isAuth()
          && (request.auth.uid == resource.data.ownerUid
              || request.auth.uid in resource.data.collaboratorUids);

      allow delete: if false;

      // ── lists/{listId}/items/{itemId} ─────────────────────────────────
      // Full access for list members only.
      match /items/{itemId} {
        allow read, write: if isAuth() && isMember(listId);
      }
    }

    // ── catalog/{entryId} ────────────────────────────────────────────────
    // Strictly private per-user.  ownerUid is checked on both read and write.
    // On create, check incoming resource (document doesn't exist yet).
    match /catalog/{entryId} {
      allow read, update, delete: if isAuth()
          && resource.data.ownerUid == request.auth.uid;
      allow create: if isAuth()
          && request.resource.data.ownerUid == request.auth.uid;
    }
  }
}
