rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function listDoc(listId) {
      return get(/databases/$(database)/documents/lists/$(listId)).data;
    }

    function isListCollaborator(listId) {
      return isSignedIn() && uid() in listDoc(listId).collaboratorUids;
    }

    // Resolved admin set for a list. Legacy docs missing the `admins` field
    // fall back to a single-admin set of [ownerUid] so existing lists keep
    // working without a backfill migration.
    function adminsOf(listData) {
      return listData.get('admins', [listData.ownerUid]);
    }

    function isListAdmin(listData) {
      return isSignedIn() && uid() in adminsOf(listData);
    }

    // True when the signed-in user has been invited by email but hasn't yet
    // claimed the list - used to grant the minimum read/update they need to
    // promote themselves into collaboratorUids on first sign-in.
    function isPendingInvitee(listData) {
      return isSignedIn()
        && listData.pendingInviteEmails != null
        && request.auth.token.email in listData.pendingInviteEmails;
    }

    // User profiles.
    //
    // Public top-level doc holds ONLY the fields cross-user reads need
    // (uid, email, displayName, photoURL). Activity metadata and
    // preferences (lastLoginAt, lastSeenLists, lastSeenListMap,
    // defaultListId) live in `users/{userId}/private/state` - owner only.
    //
    // The list of keys allowed in update affectedKeys() includes the legacy
    // private keys so the one-shot migration in auth.service.ts can strip
    // them via deleteField(); no new arbitrary keys are accepted.
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn() && uid() == userId
        && request.resource.data.uid == userId
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 200
        && (!('photoURL' in request.resource.data.keys())
            || request.resource.data.photoURL is string)
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL']);
      allow update: if isSignedIn() && uid() == userId
        && request.resource.data.uid == userId
        && (!('email' in request.resource.data.keys())
            || (request.resource.data.email is string
                && request.resource.data.email.size() <= 254))
        && (!('displayName' in request.resource.data.keys())
            || (request.resource.data.displayName is string
                && request.resource.data.displayName.size() <= 200))
        && (!('photoURL' in request.resource.data.keys())
            || request.resource.data.photoURL is string)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly([
               'uid', 'email', 'displayName', 'photoURL',
               // Legacy keys allowed only because the migration strips them
               // via deleteField(); new writes never introduce them.
               'lastLoginAt', 'lastSeenLists', 'lastSeenListMap', 'defaultListId',
             ]);
      allow delete: if isSignedIn() && uid() == userId;

      // Owner-only private state. No cross-user reads possible - closes the
      // PII surface that the top-level `allow get` would otherwise expose.
      match /private/{docId} {
        allow read, write, delete: if isSignedIn() && uid() == userId;
      }

      // In-app notifications inbox. Server-only writes via the admin SDK
      // (bypasses rules); the recipient can read + delete their own docs
      // (the popover render-then-purge flow batch-deletes everything it
      // shows). No client writes allowed - a collaborator can never spoof
      // a notification into another user's inbox.
      match /notifications/{notifId} {
        allow read, delete: if isSignedIn() && uid() == userId;
        allow write: if false;
      }
    }

    // Lists. Permissions are now driven by the admins set; `ownerUid` is the
    // creator-of-record (kept stable for cascade-delete pivot logic).
    match /lists/{listId} {
      allow read: if isSignedIn() && (
        uid() in resource.data.collaboratorUids
        || isPendingInvitee(resource.data)
      );

      allow create: if isSignedIn()
        && request.resource.data.ownerUid == uid()
        && uid() in request.resource.data.collaboratorUids
        // Creator must seed admins=[self]. Bare-string in-list check via toSet.
        && request.resource.data.admins.toSet() == [uid()].toSet()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.itemCount == 0
        && request.resource.data.urgentCount == 0
        && request.resource.data.wallpaper is string
        && request.resource.data.createdAt is number
        && request.resource.data.updatedAt is number
        && request.resource.data.keys().hasOnly(['id', 'name', 'ownerUid', 'collaboratorUids', 'admins', 'itemCount', 'urgentCount', 'wallpaper', 'createdAt', 'updatedAt', 'pendingInviteEmails', 'sortIndex', 'categoryOrder']);

      allow update: if isSignedIn() && (
        // Admin update: may touch any of the privileged fields. createdAt is
        // immutable. After the write the list must keep at least one admin
        // (drop-last-admin protection - enforced here so a buggy client can't
        // brick a shared list). categoryOrder, when present, must be a list
        // capped at 12 entries (the size of CATEGORY_ORDER).
        (
          isListAdmin(resource.data)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.get('admins', [request.resource.data.ownerUid]).size() >= 1
          && (!('categoryOrder' in request.resource.data.keys())
              || (request.resource.data.categoryOrder is list
                  && request.resource.data.categoryOrder.size() <= 12))
          && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly([
               'name',
               'collaboratorUids',
               'pendingInviteEmails',
               'wallpaper',
               'itemCount',
               'urgentCount',
               'updatedAt',
               'admins',
               'ownerUid',
               'sortIndex',
               'categoryOrder'
             ])
        )
        // Non-admin self-leave: a collaborator may remove themself from
        // collaboratorUids (and admins, if they were one). ownerUid stays.
        || (
          !isListAdmin(resource.data)
          && uid() in resource.data.collaboratorUids
          && !(uid() in request.resource.data.collaboratorUids)
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.collaboratorUids.toSet()
             == resource.data.collaboratorUids.toSet().difference([uid()].toSet())
          && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['collaboratorUids', 'admins', 'updatedAt'])
        )
        // Any collaborator may bump itemCount / urgentCount + updatedAt (denormalized counters on item writes).
        || (
          uid() in resource.data.collaboratorUids
          && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['itemCount', 'urgentCount', 'updatedAt'])
        )
        // Any collaborator may reorder categories. Shared per-list ordering,
        // intentionally open to all collaborators - shopping route is shared
        // physical space and gating it behind admin would be friction. I2:
        // categoryOrder must be a list with ≤12 entries (CATEGORY_ORDER size)
        // so a tampered client can't write garbage / oversized payloads.
        || (
          uid() in resource.data.collaboratorUids
          && request.resource.data.categoryOrder is list
          && request.resource.data.categoryOrder.size() <= 12
          && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['categoryOrder', 'updatedAt'])
        )
        // Self-claim: an invited user (email in pendingInviteEmails) promotes
        // themselves into collaboratorUids and removes their own email from the
        // pending array. They cannot touch any other field, cannot remove any
        // existing collaborator, and cannot drop any other pending invitee.
        || (
          isPendingInvitee(resource.data)
          && uid() in request.resource.data.collaboratorUids
          && !(uid() in resource.data.collaboratorUids)
          && !(request.auth.token.email in request.resource.data.pendingInviteEmails)
          && request.resource.data.collaboratorUids.toSet()
             == resource.data.collaboratorUids.toSet().union([uid()].toSet())
          && request.resource.data.pendingInviteEmails.toSet()
             == resource.data.pendingInviteEmails.toSet().difference([request.auth.token.email].toSet())
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['collaboratorUids', 'pendingInviteEmails', 'updatedAt'])
        )
      );

      allow delete: if isSignedIn() && isListAdmin(resource.data);

      // Items - any collaborator on the parent list.
      match /items/{itemId} {
        // `priority` is optional. When present it must be a known enum value;
        // when absent the write still passes (hasOnly permits a subset).
        function validPriority(data) {
          return !('priority' in data.keys())
            || data.priority in ['urgent', 'optional'];
        }

        allow read, delete: if isListCollaborator(listId);
        allow create: if isListCollaborator(listId)
          && request.resource.data.id == itemId
          && request.resource.data.listId == listId
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 200
          && request.resource.data.quantity is string
          && request.resource.data.quantity.size() <= 100
          && request.resource.data.category is string
          && request.resource.data.note is string
          && request.resource.data.note.size() <= 1000
          && request.resource.data.checked is bool
          && request.resource.data.createdByUid == uid()
          && request.resource.data.createdAt is number
          && request.resource.data.updatedAt is number
          && validPriority(request.resource.data)
          && request.resource.data.keys().hasOnly(['id', 'listId', 'name', 'quantity', 'category', 'note', 'checked', 'priority', 'photoURL', 'thumbURL', 'createdByUid', 'createdAt', 'updatedAt']);
        allow update: if isListCollaborator(listId)
          && request.resource.data.id == resource.data.id
          && request.resource.data.listId == resource.data.listId
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 200
          && request.resource.data.quantity is string
          && request.resource.data.quantity.size() <= 100
          && request.resource.data.category is string
          && request.resource.data.note is string
          && request.resource.data.note.size() <= 1000
          && request.resource.data.checked is bool
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdByUid == resource.data.createdByUid
          && validPriority(request.resource.data)
          && request.resource.data.keys().hasOnly(['id', 'listId', 'name', 'quantity', 'category', 'note', 'checked', 'priority', 'photoURL', 'thumbURL', 'createdByUid', 'createdAt', 'updatedAt']);
      }

      // Per-list favorite shelf state - any collaborator on the parent list.
      // Holds usage counts + pinned/excluded/dismissedFavorite flags scoped
      // to this list only (no cross-list bleed).
      match /favoriteState/{slug} {
        // Optional booleans - when present must be bools; when absent OK.
        function validOptionalBool(data, k) {
          return !(k in data.keys()) || data[k] is bool;
        }

        allow read, delete: if isListCollaborator(listId);
        allow create, update: if isListCollaborator(listId)
          && request.resource.data.slug == slug
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 200
          && request.resource.data.category is string
          && request.resource.data.usageCount is number
          && request.resource.data.usageCount >= 0
          && request.resource.data.lastUsedAt is number
          && validOptionalBool(request.resource.data, 'pinned')
          && validOptionalBool(request.resource.data, 'excluded')
          && validOptionalBool(request.resource.data, 'dismissedFavorite')
          && request.resource.data.keys().hasOnly(['slug', 'name', 'category', 'usageCount', 'lastUsedAt', 'pinned', 'excluded', 'dismissedFavorite']);
      }
    }

    // Rate-limit token buckets. Written only by netlify functions via the
    // admin SDK (rules bypassed there). Clients must never read or write
    // these docs directly - locks an attacker out of probing the limiter.
    match /rateLimits/{docId} {
      allow read, write: if false;
    }

    // Per-user catalog - owner only.
    match /catalog/{userId}/entries/{entryId} {
      allow read, delete: if isSignedIn() && uid() == userId;
      allow create, update: if isSignedIn() && uid() == userId
        && request.resource.data.id == entryId
        && request.resource.data.ownerUid == userId
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 200
        && request.resource.data.category is string
        && request.resource.data.usageCount is number
        && request.resource.data.usageCount >= 0
        && request.resource.data.lastUsedAt is number
        && request.resource.data.keys().hasOnly(['id', 'ownerUid', 'name', 'category', 'usageCount', 'lastUsedAt']);
    }
  }
}
