rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function listDoc(listId) {
      return get(/databases/$(database)/documents/lists/$(listId)).data;
    }

    function isListCollaborator(listId) {
      return isSignedIn() && uid() in listDoc(listId).collaboratorUids;
    }

    // True when the signed-in user has been invited by email but hasn't yet
    // claimed the list — used to grant the minimum read/update they need to
    // promote themselves into collaboratorUids on first sign-in.
    function isPendingInvitee(listData) {
      return isSignedIn()
        && listData.pendingInviteEmails != null
        && request.auth.token.email in listData.pendingInviteEmails;
    }

    // User profiles — any authenticated user can read (email lookup); write only self.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && uid() == userId;
    }

    // Lists — collaborators read; owner mutates name + collaborators + invites; non-owner can only remove self.
    // Invited (pending) users also get read + a restricted self-claim update so they can promote themselves on first sign-in.
    match /lists/{listId} {
      allow read: if isSignedIn() && (
        uid() in resource.data.collaboratorUids
        || isPendingInvitee(resource.data)
      );

      allow create: if isSignedIn()
        && request.resource.data.ownerUid == uid()
        && uid() in request.resource.data.collaboratorUids;

      allow update: if isSignedIn() && (
        // Owner update: may only touch name, collaboratorUids, pendingInviteEmails,
        // wallpaper, showFavorites, itemCount, updatedAt. ownerUid + createdAt must stay;
        // owner must remain a collaborator.
        (
          uid() == resource.data.ownerUid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.createdAt == resource.data.createdAt
          && resource.data.ownerUid in request.resource.data.collaboratorUids
          && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'collaboratorUids', 'pendingInviteEmails', 'wallpaper', 'showFavorites', 'itemCount', 'updatedAt'])
        )
        // Owner-transfer: current owner hands ownership to an existing collaborator,
        // removing themself from collaboratorUids. Only ownerUid + collaboratorUids + updatedAt change.
        || (
          uid() == resource.data.ownerUid
          && request.resource.data.ownerUid != resource.data.ownerUid
          && request.resource.data.ownerUid in resource.data.collaboratorUids
          && request.resource.data.ownerUid in request.resource.data.collaboratorUids
          && !(uid() in request.resource.data.collaboratorUids)
          && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['ownerUid', 'collaboratorUids', 'updatedAt'])
        )
        // Non-owner update: only allowed to remove own uid from collaboratorUids.
        || (
          uid() != resource.data.ownerUid
          && uid() in resource.data.collaboratorUids
          && !(uid() in request.resource.data.collaboratorUids)
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.collaboratorUids.toSet()
             == resource.data.collaboratorUids.toSet().difference([uid()].toSet())
          && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['collaboratorUids', 'updatedAt'])
        )
        // Any collaborator may bump itemCount + updatedAt (denormalized counter on item writes).
        || (
          uid() in resource.data.collaboratorUids
          && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['itemCount', 'updatedAt'])
        )
        // Self-claim: an invited user (email in pendingInviteEmails) promotes
        // themselves into collaboratorUids and removes their own email from the
        // pending array. They cannot touch any other field, cannot remove any
        // existing collaborator, and cannot drop any other pending invitee.
        || (
          isPendingInvitee(resource.data)
          && uid() in request.resource.data.collaboratorUids
          && !(uid() in resource.data.collaboratorUids)
          && !(request.auth.token.email in request.resource.data.pendingInviteEmails)
          && request.resource.data.collaboratorUids.toSet()
             == resource.data.collaboratorUids.toSet().union([uid()].toSet())
          && request.resource.data.pendingInviteEmails.toSet()
             == resource.data.pendingInviteEmails.toSet().difference([request.auth.token.email].toSet())
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['collaboratorUids', 'pendingInviteEmails', 'updatedAt'])
        )
      );

      allow delete: if isSignedIn() && uid() == resource.data.ownerUid;

      // Items — any collaborator on the parent list.
      match /items/{itemId} {
        allow read, write: if isListCollaborator(listId);
      }
    }

    // Per-user catalog — owner only.
    match /catalog/{userId}/entries/{entryId} {
      allow read, write: if isSignedIn() && uid() == userId;
    }
  }
}
